<shadui:Window
  x:Class="ShadUI.Demo.MainWindow" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:ShadUI.Demo.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:demo="clr-namespace:ShadUI.Demo"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  d:DesignWidth="800" x:Name="Window"
  Title="ShadUI App" Width="1024"
  Height="768" x:DataType="demo:MainWindowViewModel"
  Icon="/Assets/favicon.ico" SaveWindowState="True"
  TitleFontWeight="SemiBold" TransparencyLevelHint="Mica,Blur,None"
  WindowStartupLocation="CenterScreen" mc:Ignorable="d">
  <shadui:Window.LogoContent>
    <PathIcon
      Width="14" Height="14"
      Margin="8,8,0,8"
      Data="{x:Static shadui:Icons.Logo}"/>
  </shadui:Window.LogoContent>
  <shadui:Window.Hosts>
    <shadui:DialogHost
      x:Name="PART_DialogHost"
      Manager="{Binding DialogManager}"
      Owner="{Binding RelativeSource={RelativeSource AncestorType=shadui:Window}}"/>
  </shadui:Window.Hosts>
  <shadui:Window.RightWindowTitleBarContent>
    <StackPanel
      Orientation="Horizontal" Spacing="8">
      <Button
        Width="30" Height="30"
        Command="{Binding SwitchThemeCommand}"
        CornerRadius="{DynamicResource MdCornerRadius}"
        ToolTip.Tip="Switch Theme">
        <TextBlock
          Classes="LucideIcon"
          Text="{Binding CurrentTheme, Converter={x:Static converters:ThemeModeConverters.ToLucideIcon}}"/>
      </Button>
      <Button
        x:Name="FullscreenButton" Width="30"
        Height="30"
        CornerRadius="{DynamicResource MdCornerRadius}">
        <Panel>
          <TextBlock
            Classes="LucideIcon"
            IsVisible="{Binding #Window.WindowState, Converter={x:Static converters:WindowStateConverters.IsNotFullScreen}}"
            Text="&#58681;"/>
          <TextBlock
            Classes="LucideIcon"
            IsVisible="{Binding #Window.WindowState, Converter={x:Static converters:WindowStateConverters.IsFullScreen}}"
            Text="&#57631;"/>
        </Panel>
      </Button>
    </StackPanel>
  </shadui:Window.RightWindowTitleBarContent>
  <Panel>
    <Grid ColumnDefinitions="Auto *">
      <shadui:NavigationBar
        Grid.Column="0" Width="200"
        MinWidth="68" Padding="8"
        BorderBrush="{DynamicResource BorderColor30}"
        CurrentRoute="{Binding CurrentRoute}">
        <Border
          Padding="6" VerticalAlignment="Top"
          Background="{DynamicResource CardBackgroundColor}"
          BorderThickness="0"
          CornerRadius="{DynamicResource 3XlCornerRadius}">
          <StackPanel Spacing="4">
            <shadui:NavigationBarItem
              Command="{Binding OpenDashboardCommand}"
              Content="Dashboard" IsChecked="True"
              Route="dashboard"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Dashboard'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57793;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenThemeCommand}"
              Content="Theming" Route="theme"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Theming'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58088;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenTypographyCommand}"
              Content="Typography" Route="typography"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Typography'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58887;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenAvatarCommand}"
              Content="Avatar" Route="avatar"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Avatar'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58470;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenBadgeCommand}"
              Content="Badge" Route="badge"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Badge'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58416;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenButtonsCommand}"
              Content="Button" Route="button"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Buttons'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57636;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenCardsCommand}"
              Content="Card" Route="card"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Cards'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57506;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenCheckBoxesCommand}"
              Content="CheckBox" Route="checkbox"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='CheckBox'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58568;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenCheckUpdateCommand}"
              Content="CheckUpdate" Route="checkupdate"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='CheckUpdate'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <LucideIcon
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Kind="BadgeCheck" Size="20"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenColorsCommand}"
              Content="Color" Route="color"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Colors'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57821;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenComboBoxesCommand}"
              Content="ComboBox" Route="combobox"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='ComboBox'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57873;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenDataGridCommand}"
              Content="Data Table" Route="data-table"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Data Table'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58628;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenDateCommand}"
              Content="Date Control" Route="date"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Date'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57447;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenDialogsCommand}"
              Content="Dialog" Route="dialog"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Dialogs'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57627;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenInputsCommand}"
              Content="Input" Route="input"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Inputs'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57957;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenMenusCommand}"
              Content="Menu" Route="menu"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Menus'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58456;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenNumericsCommand}"
              Content="Numeric Input" Route="numeric"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Numerics'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="ShadUIIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#xe902;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenSidebarCommand}"
              Content="NavigationBar" Route="NavigationBar"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='NavigationBar'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57646;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenSlidersCommand}"
              Content="Slider" Route="slider"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Sliders'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58010;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenSwitchCommand}"
              Content="Switch" Route="switch"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Switch'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57739;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenTabsCommand}"
              Content="Tab Control" Route="tab-control"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Tabs'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58411;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenTimeCommand}"
              Content="Time" Route="time"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Time'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57937;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenToastCommand}"
              Content="Toast" Route="toast"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Toasts'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57980;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenToggleCommand}"
              Content="Toggle" Route="toggle"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Toggle'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58751;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenToolTipCommand}"
              Content="Tooltip" Route="tooltip"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Tooltip'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#57626;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
            <shadui:NavigationBarItem
              Command="{Binding OpenMiscellaneousCommand}"
              Content="Miscellaneous" Route="miscellaneous"
              ToolTip.Tip="{Binding $parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.NullOrString}, ConverterParameter='Miscellaneous'}">
              <shadui:NavigationBarItem.Icon>
                <Viewbox>
                  <TextBlock
                    Classes="LucideIcon"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="&#58671;"/>
                </Viewbox>
              </shadui:NavigationBarItem.Icon>
            </shadui:NavigationBarItem>
          </StackPanel>
        </Border>
        <shadui:NavigationBar.Footer>
          <Menu Classes="Single">
            <MenuItem
              Classes="NoPressedAnimation" Padding="8,0"
              HorizontalAlignment="Stretch" shadui:MenuItemAssist.PopupHorizontalOffset="4"
              shadui:MenuItemAssist.PopupPlacement="RightEdgeAlignedBottom" shadui:MenuItemAssist.PopupVerticalOffset="4"
              CornerRadius="{DynamicResource LgCornerRadius}">
              <MenuItem.Header>
                <Panel>
                  <shadui:Avatar
                    CornerRadius="{DynamicResource LgCornerRadius}"
                    Fallback="CN"
                    IsVisible="{Binding !$parent[shadui:NavigationBar].IsExpanded}"
                    Opacity="{Binding !$parent[shadui:NavigationBar].IsExpanded, Converter={x:Static converters:BooleanConverters.Opaque}}"
                    Source="../../Assets/user.png">
                    <shadui:Avatar.Transitions>
                      <Transitions>
                        <DoubleTransition
                          Property="Opacity" Duration="0:0:0.20"/>
                      </Transitions>
                    </shadui:Avatar.Transitions>
                  </shadui:Avatar>
                  <Grid
                    Margin="0,8" ColumnDefinitions="Auto * Auto"
                    IsVisible="{Binding $parent[shadui:NavigationBar].IsExpanded}">
                    <shadui:Avatar
                      Width="36" Height="36"
                      Margin="0,0,8,0"
                      CornerRadius="{DynamicResource XlCornerRadius}"
                      Fallback="CN" Source="../../Assets/user.png"/>
                    <StackPanel
                      Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock
                        Classes="Small" Text="shadui"/>
                      <TextBlock
                        Classes="Caption" Margin="0,-4,0,0"
                        Text="m@example.com"/>
                    </StackPanel>
                    <Viewbox
                      Grid.Column="2" Width="16"
                      Height="16">
                      <TextBlock
                        Classes="LucideIcon"
                        Foreground="{DynamicResource ForegroundColor}"
                        Text="&#57873;"/>
                    </Viewbox>
                  </Grid>
                </Panel>
              </MenuItem.Header>
              <shadui:MenuItemAssist.Label>
                <Grid
                  Width="220" HorizontalAlignment="Stretch"
                  ColumnDefinitions="Auto *">
                  <shadui:Avatar
                    Width="36" Height="36"
                    Margin="0,0,8,0"
                    CornerRadius="{DynamicResource XlCornerRadius}"
                    Fallback="CN" Source="../../Assets/user.png"/>
                  <StackPanel
                    Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                      Classes="Small" Text="shadui"/>
                    <TextBlock
                      Classes="Caption" Margin="0,-4,0,0"
                      Text="m@example.com"/>
                  </StackPanel>
                </Grid>
              </shadui:MenuItemAssist.Label>
              <Separator/>
              <MenuItem
                Command="{Binding ShowAboutCommand}"
                Header="About">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#57599;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/accntech/shad-ui?tab=readme-ov-file#readme" Header="Readme">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#57443;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/accntech/shad-ui" Header="Source repository">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#57862;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/accntech/shad-ui?tab=MIT-1-ov-file#readme" Header="MIT License">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#57874;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/accntech/shad-ui?tab=coc-ov-file#readme" Header="Code of Conduct">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#58071;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/accntech/shad-ui?tab=security-ov-file" Header="Security">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#57692;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/accntech/shad-ui/activity" Header="Activity">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#57400;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem
                Command="{Binding TryCloseCommand}"
                Header="Close application">
                <MenuItem.Icon>
                  <Viewbox
                    Width="16" Height="16">
                    <TextBlock
                      Classes="LucideIcon"
                      Foreground="{DynamicResource MutedColor}"
                      Text="&#57668;"/>
                  </Viewbox>
                </MenuItem.Icon>
              </MenuItem>
            </MenuItem>
          </Menu>
        </shadui:NavigationBar.Footer>
      </shadui:NavigationBar>
      <TransitioningContentControl
        Grid.Column="1"
        Content="{Binding SelectedPage}"/>
    </Grid>
    <shadui:ToastHost Manager="{Binding ToastManager}"/>
  </Panel>
</shadui:Window>