<UserControl
  x:Class="ShadUI.Demo.Views.CheckUpdatePage" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ShadUI.Demo.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shadui="clr-namespace:ShadUI.Controls;assembly=ShadUI" xmlns:viewModels="clr-namespace:ShadUI.Demo.ViewModels"
  d:DesignHeight="450" d:DesignWidth="800"
  x:DataType="viewModels:CheckUpdateViewModel" mc:Ignorable="d">
  <DockPanel LastChildFill="True">
    <StackPanel
      DockPanel.Dock="Top"
      MaxWidth="{StaticResource PageMaxWidth}"
      Margin="{StaticResource PageMargin}"
      Spacing="4">
      <Grid ColumnDefinitions="* Auto">
        <TextBlock
          Classes="h2" Text="CheckUpdate"/>
        <StackPanel
          Grid.Column="1" Orientation="Horizontal"
          Spacing="8">
          <Button
            Classes="Icon" Width="28"
            Height="28"
            Background="{DynamicResource GhostHoverColor}"
            Command="{Binding BackPageCommand}">
            <Viewbox Margin="6">
              <TextBlock
                Classes="LucideIcon" Text="&#57420;"/>
            </Viewbox>
          </Button>
          <Button
            Classes="Icon" Width="28"
            Height="28"
            Background="{DynamicResource GhostHoverColor}"
            Command="{Binding NextPageCommand}">
            <Viewbox Margin="6">
              <TextBlock
                Classes="LucideIcon" Text="&#57421;"/>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
      <TextBlock
        Classes="p" Text="A control that notifies the user about available updates."
        TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer>
      <StackPanel
        MaxWidth="{StaticResource PageMaxWidth}"
        Margin="{StaticResource PageMargin}"
        Spacing="32">
        <controls:ControlBlock
          Title="CheckUpdate"
          Xaml="{Binding UpdateAvailableCode}">
          <Grid ColumnDefinitions="2*, *">
            <StackPanel
              Grid.Column="0" Spacing="8">
              <shadui:CheckUpdate
                CheckingUpdateTitle="Checking for updates"
                IsCheckingUpdate="{Binding IsCheckingUpdate}"
                IsUpdateAvailable="{Binding IsUpdateAvailable}"
                LastUpdateCheckDate="{Binding UpdateNotAvailableLastCheckDate}"
                LastUpdateCheckTitle="Last checked: " NewVersion="v1.2.3"
                ToolTip.Tip="An update is available" UpdateAvailableTitle="Update Available"
                UpdateAvailableVersionTitle="Version" UpdateNotAvailableTitle="You're up to date"/>
            </StackPanel>
            <StackPanel
              Grid.Column="1" Spacing="5">
              <ToggleSwitch
                Content="IsUpdateAvailable"
                IsChecked="{Binding IsUpdateAvailable, Mode=TwoWay}"/>
              <ToggleSwitch
                Content="IsCheckingUpdate"
                IsChecked="{Binding IsCheckingUpdate, Mode=TwoWay}"/>
            </StackPanel>
          </Grid>
        </controls:ControlBlock>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>