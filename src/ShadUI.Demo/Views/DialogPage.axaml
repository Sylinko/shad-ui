<UserControl
    x:Class="ShadUI.Demo.Views.DialogPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ShadUI.Demo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:ShadUI.Demo.ViewModels"
    d:DesignWidth="900"
    x:DataType="viewModels:DialogViewModel"
    mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="{StaticResource PageMargin}"
            DockPanel.Dock="Top"
            Spacing="4">
            <Grid ColumnDefinitions="* Auto">
                <TextBlock Classes="h2" Text="Dialog" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Width="28"
                        Height="28"
                        Background="{DynamicResource GhostHoverColor}"
                        Classes="Icon NoPadding"
                        Command="{Binding BackPageCommand}">
                        <Viewbox Margin="6">
                            <TextBlock Classes="LucideIcon" Text="&#57420;" />
                        </Viewbox>
                    </Button>
                    <Button
                        Width="28"
                        Height="28"
                        Background="{DynamicResource GhostHoverColor}"
                        Classes="Icon NoPadding"
                        Command="{Binding NextPageCommand}">
                        <Viewbox Margin="6">
                            <TextBlock Classes="LucideIcon" Text="&#57421;" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock
                Classes="p"
                Text="A window overlaid on either the primary window or another dialog window, rendering the content underneath inert."
                TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource PageMaxWidth}"
                Margin="{StaticResource PageMargin}"
                Spacing="32">
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock Classes="h4" Text="Installation"/>
                    <Separator Margin="0"/>
                    <TextBlock Classes="Small" Text="Add a DialogHost to the window's Hosts collection. It registers automatically while attached; no manager registration or view-model mapping is needed." TextWrapping="Wrap"/>
                    <controls:CodeTextBlock Language="xaml">
                        <Run Text="&lt;shadui:ShadWindow.Hosts&gt;"/>
                        <LineBreak/>
                        <Run Text="    &lt;shadui:DialogHost /&gt;"/>
                        <LineBreak/>
                        <Run Text="&lt;/shadui:ShadWindow.Hosts&gt;"/>
                    </controls:CodeTextBlock>
                    <TextBlock Classes="Small" Text="Use DialogManager.CreateDialog(content, title) for a simple dialog, or CreateCustomDialog(control) for custom content." TextWrapping="Wrap"/>
                </StackPanel>
                <controls:ControlBlock Title="Alert Dialog" CSharp="{Binding AlertDialogCode}">
                    <StackPanel>
                        <Button
                            HorizontalAlignment="Center"
                            Classes="Outline"
                            Command="{Binding ShowDialogCommand}"
                            Content="Show Dialog" />
                    </StackPanel>
                </controls:ControlBlock>
                <controls:ControlBlock Title="Destructive Style Dialog" CSharp="{Binding DestructiveAlertDialogCode}">
                    <StackPanel>
                        <Button
                            HorizontalAlignment="Center"
                            Classes="Outline"
                            Command="{Binding ShowDestructiveStyleDialogCommand}"
                            Content="Show Dialog" />
                    </StackPanel>
                </controls:ControlBlock>
                <controls:ControlBlock Title="Custom Dialog" CSharp="{Binding CustomDialogCode}">
                    <StackPanel>
                        <Button
                            HorizontalAlignment="Center"
                            Classes="Outline"
                            Command="{Binding ShowCustomDialogCommand}"
                            Content="Show Dialog" />
                    </StackPanel>
                </controls:ControlBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>