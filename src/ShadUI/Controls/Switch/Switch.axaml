<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI">
  <Design.PreviewWith>
    <StackPanel
      Width="250" Margin="20"
      Spacing="24">
      <ToggleSwitch
        OffContent="Off" OnContent="On"/>
      <ToggleSwitch
        shadui:ToggleSwitchAssist.RightAlignedContent="True" OffContent="Off"
        OnContent="On"/>
      <ToggleSwitch IsEnabled="False"/>
    </StackPanel>
  </Design.PreviewWith>

  <ControlTheme
    x:Key="ToggleSwitchTheme" TargetType="ToggleSwitch">
    <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
    <Setter Property="OnContent" Value="{x:Null}"/>
    <Setter Property="OffContent" Value="{x:Null}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ReversibleStackPanel
          x:Name="PART_Container" Orientation="Horizontal"
          ReverseOrder="{TemplateBinding shadui:ToggleSwitchAssist.RightAlignedContent}"
          Spacing="8">
          <Panel>
            <Panel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding
                  Converter="{x:Static ObjectConverters.IsNotNull}"
                  Path="OffContent"
                  RelativeSource="{RelativeSource TemplatedParent}"/>
                <Binding
                  Converter="{x:Static ObjectConverters.IsNotNull}"
                  Path="OnContent"
                  RelativeSource="{RelativeSource TemplatedParent}"/>
              </MultiBinding>
            </Panel.IsVisible>

            <ContentPresenter
              x:Name="PART_OffContentPresenter"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding OffContent}"
              ContentTemplate="{TemplateBinding OffContentTemplate}"/>
            <ContentPresenter
              x:Name="PART_OnContentPresenter"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding OnContent}"
              ContentTemplate="{TemplateBinding OnContentTemplate}"/>
          </Panel>

          <DockPanel
            x:Name="PART_ToggleContainer" Background="Transparent">
            <ContentPresenter
              x:Name="PART_ContentPresenter" DockPanel.Dock="Top"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              RecognizesAccessKey="True"/>

            <!--  Do not round the track and thumb independently: odd physical sizes otherwise shift their centers.  -->
            <Grid
              HorizontalAlignment="Left" VerticalAlignment="Top"
              RowDefinitions="6,Auto,6" UseLayoutRounding="False">
              <Border
                Grid.Row="1" Grid.Column="0"
                Width="36" Height="20"
                Background="{DynamicResource SwitchBackgroundColor}"
                BorderThickness="0"
                CornerRadius="{DynamicResource FullCornerRadius}"/>
              <Border
                x:Name="SwitchBackground" Grid.Row="1"
                Grid.Column="0" Width="36"
                Height="20"
                Background="{DynamicResource PrimaryColor}"
                BorderThickness="0" ClipToBounds="True"
                CornerRadius="{DynamicResource FullCornerRadius}"
                Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition
                      Property="Opacity" Duration="0:0:0.2"/>
                  </Transitions>
                </Border.Transitions>
              </Border>
              <Canvas
                x:Name="PART_SwitchKnob" Grid.Row="1"
                Grid.Column="0" Width="16"
                Height="16" HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <shadui:SwitchThumbPresenter
                  x:Name="PART_ThumbPresenter" Width="36"
                  Height="16" Padding="2,0">
                  <shadui:SwitchThumbPresenter.Transitions>
                    <Transitions>
                      <DoubleTransition
                        Easing="QuarticEaseOut" Property="Position"
                        Duration="0:0:0.15"/>
                    </Transitions>
                  </shadui:SwitchThumbPresenter.Transitions>
                  <Border
                    x:Name="SwitchKnob" Width="16"
                    Height="16" ClipToBounds="True"
                    CornerRadius="{DynamicResource FullCornerRadius}">
                    <Border.Transitions>
                      <Transitions>
                        <DoubleTransition
                          Property="Width" Duration="0:0:0.05">
                          <DoubleTransition.Easing>
                            <QuadraticEaseOut/>
                          </DoubleTransition.Easing>
                        </DoubleTransition>
                      </Transitions>
                    </Border.Transitions>
                    <Panel>
                      <Border
                        x:Name="KnobOff"
                        Background="{DynamicResource SwitchForegroundColor}"
                        Opacity="1">
                        <Border.Transitions>
                          <Transitions>
                            <DoubleTransition
                              Property="Opacity" Duration="0:0:0.05">
                              <DoubleTransition.Easing>
                                <QuadraticEaseOut/>
                              </DoubleTransition.Easing>
                            </DoubleTransition>
                          </Transitions>
                        </Border.Transitions>
                      </Border>
                      <Border
                        x:Name="KnobOn"
                        Background="{DynamicResource PrimaryForegroundColor}"
                        Opacity="0">
                        <Border.Transitions>
                          <Transitions>
                            <DoubleTransition
                              Property="Opacity" Duration="0:0:0.05">
                              <DoubleTransition.Easing>
                                <QuadraticEaseOut/>
                              </DoubleTransition.Easing>
                            </DoubleTransition>
                          </Transitions>
                        </Border.Transitions>
                      </Border>
                    </Panel>
                  </Border>
                </shadui:SwitchThumbPresenter>
                <Grid x:Name="PART_MovingKnobs"/>
                <!--  Required by ToggleSwitch; the visible thumb is positioned by SwitchThumbPresenter.  -->
              </Canvas>
            </Grid>
          </DockPanel>
        </ReversibleStackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsEnabled=False] /template/ ReversibleStackPanel#PART_Container">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="^[IsEnabled=True] /template/ DockPanel#PART_ToggleContainer">
      <Style Selector="^:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
      </Style>
    </Style>

    <Style Selector="^:disabled /template/ Border#SwitchBackground">
      <Setter Property="Background" Value="{DynamicResource PrimaryColor50}"/>
    </Style>

    <Style Selector="^:unchecked">
      <Style Selector="^ /template/ Border#SwitchKnob">
        <Setter Property="Width" Value="16"/>
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_OffContentPresenter">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_OnContentPresenter">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ Border#KnobOff">
        <Setter Property="Opacity" Value="1"/>
      </Style>
      <Style Selector="^ /template/ Border#KnobOn">
        <Setter Property="Opacity" Value="0"/>
      </Style>
    </Style>

    <Style Selector="^:checked">
      <Style Selector="^/template/ Border#SwitchBackground">
        <Setter Property="Opacity" Value="1"/>
      </Style>
      <Style Selector="^/template/ Border#SwitchKnob">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryForegroundColor}"/>
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_OffContentPresenter">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_OnContentPresenter">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="^ /template/ Border#KnobOff">
        <Setter Property="Opacity" Value="0"/>
      </Style>
      <Style Selector="^ /template/ Border#KnobOn">
        <Setter Property="Opacity" Value="1"/>
      </Style>
    </Style>

    <Style Selector="^:pressed /template/ Border#SwitchKnob">
      <Setter Property="Width" Value="22"/>
    </Style>
    <Style Selector="^:checked /template/ shadui|SwitchThumbPresenter#PART_ThumbPresenter">
      <Setter Property="Position" Value="1"/>
    </Style>
  </ControlTheme>

  <ControlTheme
    x:Key="{x:Type ToggleSwitch}"
    BasedOn="{StaticResource ToggleSwitchTheme}"
    TargetType="ToggleSwitch"/>
</ResourceDictionary>
