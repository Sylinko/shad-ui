<ResourceDictionary
  xmlns:shadui="clr-namespace:ShadUI"
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Panel
      Width="500" Height="500">
      <CalendarButton
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Panel>
  </Design.PreviewWith>
  <ControlTheme
    x:Key="{x:Type CalendarButton}"
    TargetType="CalendarButton">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
    <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="RootPanel">
          <Panel.Transitions>
            <Transitions>
              <TransformOperationsTransition
                Property="RenderTransform" Duration="0:0:0.10"/>
            </Transitions>
          </Panel.Transitions>
          <shadui:SmoothBorder
            Name="BaseBackground"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Opacity="1">
            <shadui:SmoothBorder.Transitions>
              <Transitions>
                <DoubleTransition
                  Property="Opacity" Duration="0:0:0.20"/>
              </Transitions>
            </shadui:SmoothBorder.Transitions>
          </shadui:SmoothBorder>
          <shadui:SmoothBorder
            Name="HoverBackground"
            Background="{DynamicResource GhostColor}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Opacity="0">
            <shadui:SmoothBorder.Transitions>
              <Transitions>
                <DoubleTransition
                  Property="Opacity" Duration="0:0:0.20"/>
              </Transitions>
            </shadui:SmoothBorder.Transitions>
          </shadui:SmoothBorder>
          <ContentPresenter
            x:Name="ContentPresenter"
            Margin="{TemplateBinding Padding}"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            FontSize="{TemplateBinding FontSize}"
            Foreground="{TemplateBinding Foreground}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ shadui|SmoothBorder#HoverBackground">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:pointerover /template/ shadui|SmoothBorder#BaseBackground">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:pressed /template/ Panel#RootPanel">
      <Setter Property="RenderTransform" Value="scale(0.95, 0.95)"/>
    </Style>
    <Style Selector="^:pointerover /template/ Panel#RootPanel">
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundColor}"/>
      <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
      <Style Selector="^ /template/ shadui|SmoothBorder#BaseBackground">
        <Setter Property="Opacity" Value="1"/>
      </Style>
      <Style Selector="^ /template/ shadui|SmoothBorder#HoverBackground">
        <Setter Property="Opacity" Value="0"/>
      </Style>
    </Style>
    <Style Selector="^:inactive">
      <Setter Property="Opacity" Value="0.50"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>