<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI" x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="24">
      <StackPanel Spacing="12">
        <Border
          MaxWidth="500"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="{DynamicResource LgCornerRadius}">
          <shadui:SimpleDialog
            Title="Are you absolutely sure?" CancelButtonContent="Cancel"
            CancelButtonStyle="Outline" Content="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
            PrimaryButtonContent="Continue"/>
        </Border>
        <Border
          MaxWidth="500"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="{DynamicResource LgCornerRadius}">
          <shadui:SimpleDialog
            Title="Are you absolutely sure?" CancelButtonContent="Cancel"
            CancelButtonStyle="Outline" Content="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
            PrimaryButtonContent="Delete" PrimaryButtonStyle="Destructive"/>
        </Border>
        <Border
          MaxWidth="500"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="{DynamicResource LgCornerRadius}">
          <shadui:SimpleDialog
            Title="Are you absolutely sure?" CancelButtonContent="Cancel"
            CancelButtonStyle="Ghost" Content="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
            PrimaryButtonContent="Yes" SecondaryButtonContent="No"
            SecondaryButtonStyle="Secondary" TertiaryButtonContent="Maybe"
            TertiaryButtonStyle="Outline"/>
        </Border>
      </StackPanel>
    </Border>
  </Design.PreviewWith>
  <ControlTheme
    x:Key="SimpleDialogTheme" TargetType="shadui:SimpleDialog">
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <DockPanel
            Margin="{TemplateBinding Padding}"
            VerticalSpacing="16">
            <ContentPresenter
              x:Name="DialogTitle" DockPanel.Dock="Top"
              Content="{TemplateBinding Title}"
              FontSize="{DynamicResource FontSizeL}"
              FontWeight="DemiBold"
              IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}"
              TextWrapping="Wrap"/>

            <StackPanel
              x:Name="ButtonContainer" DockPanel.Dock="Bottom"
              HorizontalAlignment="Right" Orientation="Horizontal"
              Spacing="8">
              <Button
                x:Name="PART_CancelButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding CancelButtonStyle, Converter={x:Static shadui:ButtonStyleConverters.ToClass}}"
                Content="{TemplateBinding CancelButtonContent}"
                IsVisible="{TemplateBinding CancelButtonContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button
                x:Name="PART_TertiaryButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding TertiaryButtonStyle, Converter={x:Static shadui:ButtonStyleConverters.ToClass}}"
                Content="{TemplateBinding TertiaryButtonContent}"
                IsVisible="{TemplateBinding TertiaryButtonContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button
                x:Name="PART_SecondaryButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding SecondaryButtonStyle, Converter={x:Static shadui:ButtonStyleConverters.ToClass}}"
                Content="{TemplateBinding SecondaryButtonContent}"
                IsVisible="{TemplateBinding SecondaryButtonContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button
                x:Name="PART_PrimaryButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding PrimaryButtonStyle, Converter={x:Static shadui:ButtonStyleConverters.ToClass}}"
                shadui:ElementAssist.FocusOnLoad="True"
                Content="{TemplateBinding PrimaryButtonContent}"
                IsVisible="{TemplateBinding PrimaryButtonContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <ScrollViewer
              Margin="0,0,-12,0" ClipToBounds="False"
              HorizontalScrollBarVisibility="Disabled">
              <ContentPresenter
                Margin="0,0,12,0"
                Content="{TemplateBinding Content}"
                FontSize="{DynamicResource FontSizeM}"
                FontWeight="Medium"
                Foreground="{DynamicResource MutedColor}"
                TextWrapping="Wrap"/>
            </ScrollViewer>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>

  <ControlTheme
    x:Key="{x:Type shadui:SimpleDialog}"
    BasedOn="{StaticResource SimpleDialogTheme}"
    TargetType="shadui:SimpleDialog"/>
</ResourceDictionary>