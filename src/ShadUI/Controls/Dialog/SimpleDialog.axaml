<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI" x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="24">
      <StackPanel Spacing="12">
        <Border
          MaxWidth="500"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="{DynamicResource LgCornerRadius}">
          <shadui:SimpleDialog
            Title="Are you absolutely sure?" CancelButtonContent="Cancel"
            CancelButtonStyle="Outline" Content="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
            PrimaryButtonContent="Continue"/>
        </Border>
        <Border
          MaxWidth="500"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="{DynamicResource LgCornerRadius}">
          <shadui:SimpleDialog
            Title="Are you absolutely sure?" CancelButtonContent="Cancel"
            CancelButtonStyle="Outline" Content="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
            PrimaryButtonContent="Delete" PrimaryButtonStyle="Destructive"/>
        </Border>
        <Border
          MaxWidth="500"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="{DynamicResource LgCornerRadius}">
          <shadui:SimpleDialog
            Title="Are you absolutely sure?" CancelButtonContent="Cancel"
            CancelButtonStyle="Ghost" Content="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
            PrimaryButtonContent="Yes" SecondaryButtonContent="No"
            SecondaryButtonStyle="Secondary" TertiaryButtonContent="Maybe"
            TertiaryButtonStyle="Outline"/>
        </Border>
      </StackPanel>
    </Border>
  </Design.PreviewWith>
  <ControlTheme
    x:Key="SimpleDialogTheme" TargetType="shadui:SimpleDialog">
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <StackPanel
            Margin="{TemplateBinding Padding}"
            Spacing="16">
            <StackPanel.Styles>
              <Style Selector="ContentPresenter#DialogTitle TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeL}"/>
                <Setter Property="FontWeight" Value="DemiBold"/>
              </Style>
            </StackPanel.Styles>
            <ContentPresenter
              x:Name="DialogTitle"
              Content="{TemplateBinding Title}"
              IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}"
              TextWrapping="Wrap"/>
            <ContentPresenter
              Content="{TemplateBinding Content}"
              FontSize="14" FontWeight="Medium"
              Foreground="{DynamicResource MutedColor}"
              LineHeight="20" TextWrapping="Wrap"/>
            <StackPanel
              Name="ButtonContainer" HorizontalAlignment="Right"
              Orientation="Horizontal" Spacing="8">
              <Button
                Name="PART_CancelButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding CancelButtonStyle, Converter={x:Static shadui:DialogButtonStyleConverters.ToClass}}"
                Content="{TemplateBinding CancelButtonContent}"
                IsVisible="{CompiledBinding $self.Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button
                Name="PART_TertiaryButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding TertiaryButtonStyle, Converter={x:Static shadui:DialogButtonStyleConverters.ToClass}}"
                Content="{TemplateBinding TertiaryButtonContent}"
                IsVisible="{CompiledBinding $self.Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button
                Name="PART_SecondaryButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding SecondaryButtonStyle, Converter={x:Static shadui:DialogButtonStyleConverters.ToClass}}"
                Content="{TemplateBinding SecondaryButtonContent}"
                IsVisible="{CompiledBinding $self.Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button
                Name="PART_PrimaryButton" MinWidth="80"
                shadui:ElementAssist.Classes="{TemplateBinding PrimaryButtonStyle, Converter={x:Static shadui:DialogButtonStyleConverters.ToClass}}"
                shadui:ElementAssist.FocusOnLoad="True"
                Content="{TemplateBinding PrimaryButtonContent}"
                IsVisible="{CompiledBinding $self.Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>

  <ControlTheme
    x:Key="{x:Type shadui:SimpleDialog}"
    BasedOn="{StaticResource SimpleDialogTheme}"
    TargetType="shadui:SimpleDialog"/>
</ResourceDictionary>