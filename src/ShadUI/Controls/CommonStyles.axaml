<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shadUi="clr-namespace:ShadUI">
    <Style Selector="shadUi|Badge, Button">
        <Style Selector="^.rounded-none">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="^.rounded-xs">
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style Selector="^.rounded-sm">
            <Setter Property="CornerRadius" Value="{DynamicResource SmCornerRadius}" />
        </Style>
        <Style Selector="^.rounded">
            <Setter Property="CornerRadius" Value="{DynamicResource SmCornerRadius}" />
        </Style>

        <Style Selector="^.rounded-md">
            <Setter Property="CornerRadius" Value="{DynamicResource MdCornerRadius}" />
        </Style>

        <Style Selector="^.rounded-lg">
            <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}" />
        </Style>

        <Style Selector="^.rounded-xl">
            <Setter Property="CornerRadius" Value="{DynamicResource XlCornerRadius}" />
        </Style>

        <Style Selector="^.rounded-2xl">
            <Setter Property="CornerRadius" Value="{DynamicResource 2XlCornerRadius}" />
        </Style>

        <Style Selector="^.rounded-3xl">
            <Setter Property="CornerRadius" Value="{DynamicResource 3XlCornerRadius}" />
        </Style>

        <Style Selector="^.rounded-4xl">
            <Setter Property="CornerRadius" Value="{DynamicResource 4XlCornerRadius}" />
        </Style>

        <Style Selector="^.rounded-full">
            <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}" />
        </Style>
    </Style>
  
    <!-- Global: ToolTip Styles -->
    <Style Selector=":is(Control)">
      <Setter Property="ToolTip.ShowDelay" Value="50" />
      <Setter Property="ToolTip.Placement" Value="Top"/>
      
      <Style Selector="^[(ToolTip.Placement)=Top]">
        <Style Selector="^ Border#PART_LayoutRoot">
          <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="^ Path#Arrow">
          <Setter Property="IsVisible" Value="True"/>
          <Setter Property="VerticalAlignment" Value="Bottom"/>
          <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
      </Style>
      
      <Style Selector="^[(ToolTip.Placement)=Bottom]">
        <Style Selector="^ Border#PART_LayoutRoot">
          <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style Selector="^ Path#Arrow">
          <Setter Property="IsVisible" Value="True"/>
          <Setter Property="VerticalAlignment" Value="Top"/>
          <Setter Property="HorizontalAlignment" Value="Center"/>
          <Setter Property="RenderTransform">
            <RotateTransform Angle="180"/>
          </Setter>
        </Style>
      </Style>

      <Style Selector="^[(ToolTip.Placement)=Left]">
        <Style Selector="^ Border#PART_LayoutRoot">
          <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="^ Path#Arrow">
          <Setter Property="IsVisible" Value="True"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="HorizontalAlignment" Value="Right"/>
          <Setter Property="RenderTransform">
            <RotateTransform Angle="-90"/>
          </Setter>
          <Setter Property="Margin" Value="0,0,-2,0"/>
        </Style>
      </Style>

      <Style Selector="^[(ToolTip.Placement)=Right]">
        <Style Selector="^ Border#PART_LayoutRoot">
          <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style Selector="^ Path#Arrow">
          <Setter Property="IsVisible" Value="True"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="HorizontalAlignment" Value="Left"/>
          <Setter Property="RenderTransform">
            <RotateTransform Angle="90"/>
          </Setter>
          <Setter Property="Margin" Value="-2,0,0,0"/>
        </Style>
      </Style>
    </Style>
</Styles>
