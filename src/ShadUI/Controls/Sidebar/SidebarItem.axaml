<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI" xmlns:system="clr-namespace:System;assembly=netstandard">
  <ControlTheme
    x:Key="{x:Type shadui:SidebarItem}"
    TargetType="{x:Type shadui:SidebarItem}">
    <Setter Property="Width" Value="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Control}}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="GroupName" Value="{Binding $parent[shadui:Sidebar].DefaultItemsGroup}"/>
    <Setter Property="Expanded" Value="{Binding $parent[shadui:Sidebar].Expanded}"/>
    <Setter Property="Spacing" Value="{Binding $parent[shadui:Sidebar].ItemIconContentSpacing}"/>
    <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
    <Setter Property="TextBlock.MaxLines" Value="2"/>
    <Setter Property="Padding" Value="10,10"/>
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}"/>
    <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip.Placement" Value="Right"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel
          Name="RootPanel" Background="Transparent">
          <Panel.Styles>
            <Style Selector="LucideIcon">
              <Setter Property="Foreground" Value="{Binding $parent[shadui:SidebarItem].Foreground}"/>
            </Style>
          </Panel.Styles>
          <Panel.Transitions>
            <Transitions>
              <TransformOperationsTransition
                Property="RenderTransform" Duration="0:0:0.10"/>
            </Transitions>
          </Panel.Transitions>
          <Border
            Name="BaseBackground"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Opacity="1">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition
                  Property="Opacity" Duration="0:0:0.20"/>
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border
            Name="HoverBackground"
            Background="{DynamicResource GhostHoverColor}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition
                  Property="Opacity" Duration="0:0:0.20"/>
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border
            Name="SelectedBackground"
            Background="{DynamicResource GhostColor}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition
                  Property="Opacity" Duration="0:0:0.20"/>
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border
            Name="PART_BorderContainer"
            Padding="{TemplateBinding Padding}"
            ClipToBounds="True"
            CornerRadius="{TemplateBinding CornerRadius}"
            TextElement.Foreground="{TemplateBinding Foreground}">
            <StackPanel
              Name="PART_StackPanelContainer" Orientation="Horizontal"
              Spacing="{TemplateBinding Spacing}">
              <ContentControl Content="{TemplateBinding Icon}"/>
              <ContentPresenter
                Name="PART_ContentPresenter"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                RecognizesAccessKey="True"
                TextBlock.FontSize="{TemplateBinding FontSize}"
                TextBlock.FontWeight="{TemplateBinding FontWeight}"
                TextBlock.MaxLines="{TemplateBinding TextBlock.MaxLines}"
                TextBlock.TextTrimming="{TemplateBinding TextBlock.TextTrimming}"
                TextBlock.TextWrapping="{TemplateBinding TextBlock.TextWrapping}">
                <ContentPresenter.Transitions>
                  <Transitions>
                    <TransformOperationsTransition
                      Easing="{StaticResource StrongEaseOutBack}"
                      Property="RenderTransform" Duration="0:0:0.4"/>
                    <DoubleTransition
                      Easing="CubicEaseInOut" Property="Opacity"
                      Duration="0:0:0.2"/>
                  </Transitions>
                </ContentPresenter.Transitions>
                <ContentPresenter.DataTemplates>
                  <DataTemplate DataType="system:String">
                    <TextBlock Text="{CompiledBinding}"/>
                  </DataTemplate>
                </ContentPresenter.DataTemplates>

                <Interaction.Behaviors>
                  <shadui:DelayFromIndexBehavior
                    Multiplier="0:0:0.05"
                    Self="{Binding $parent[shadui:SidebarItem]}"
                    Target="{Binding #PART_ContentPresenter.Transitions[0], FallbackValue={x:Null}}"/>
                </Interaction.Behaviors>
              </ContentPresenter>
            </StackPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!--  Nested Selectors For Default Button  -->
    <Style Selector="^ /template/ TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="^[Expanded=False]">
      <Style Selector="^ /template/ Grid#Grid">
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
      <Style Selector="^[HasIcon=False]">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition
              Easing="{StaticResource StrongEaseOutBack}"
              Property="RenderTransform" Duration="0:0:0.4"/>
            <DoubleTransition
              Easing="CubicEaseInOut" Property="Opacity"
              Duration="0:0:0.2"/>
            <BoolTransition
              Property="IsVisible" Duration="0:0:0.4"/>
          </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="translate(20px, 0)"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#HoverBackground">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#BaseBackground">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:checked /template/ Border#SelectedBackground">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:pressed /template/ Panel#RootPanel">
      <Setter Property="RenderTransform" Value="scale(0.95, 0.95)"/>
    </Style>

    <!--  NoPressedAnimation  -->
    <Style Selector="^.NoPressedAnimation">
      <Style Selector="^:pressed /template/ Panel#RootPanel">
        <Setter Property="RenderTransform" Value="scale(1, 1)"/>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>