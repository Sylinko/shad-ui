<Styles
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    SimpleTheme configures PopupRoot transparency before the native window is shown.
    Presenters must not forward transparency hints to the host again.
  -->
  <SimpleTheme/>
  <StyleInclude Source="avares://ShadUI/Controls/CommonStyles.axaml"/>
  <StyleInclude Source="avares://ShadUI/Controls/DataGrid/DataGridStyles.axaml"/>
  <StyleInclude Source="avares://ShadUI/Controls/Loading/LoadingStyles.axaml"/>
  <StyleInclude Source="avares://ShadUI/Controls/ScrollViewer/ScrollBar.axaml"/>
  <StyleInclude Source="avares://ShadUI/Controls/ScrollViewer/ScrollViewer.axaml"/>
  <StyleInclude Source="avares://ShadUI/Controls/Separator/SeparatorStyles.axaml"/>
</Styles>