<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI">
  <ControlTheme
    x:Key="NavigationTogglerTheme" TargetType="ToggleButton">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}"/>
    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="RootPanel">
          <Panel.Transitions>
            <Transitions>
              <TransformOperationsTransition
                Property="RenderTransform" Duration="0:0:0.10"/>
            </Transitions>
          </Panel.Transitions>
          <Border
            Name="HoverBackground"
            Background="{TemplateBinding Background}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition
                  Property="Opacity" Duration="0:0:0.20"/>
              </Transitions>
            </Border.Transitions>
          </Border>
          <ContentPresenter
            Padding="{TemplateBinding Padding}"
            Content="{TemplateBinding Content}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed /template/ Panel#RootPanel">
      <Setter Property="RenderTransform" Value="scale(0.95, 0.95)"/>
    </Style>
    <Style Selector="^:checked /template/ Border#HoverBackground">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#HoverBackground">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.50"/>
    </Style>
  </ControlTheme>

  <ControlTheme
    x:Key="{x:Type shadui:NavigationBar}"
    TargetType="{x:Type shadui:NavigationBar}">
    <Setter Property="Background" Value="{DynamicResource TransparentColor}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource 3XlCornerRadius}"/>
    <Setter Property="MinWidth" Value="52"/>
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="HorizontalSpacing" Value="8"/>
    <Setter Property="VerticalSpacing" Value="8"/>

    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Easing="{x:Static shadui:EaseOutBack.Strong}"
          Property="Opacity" Duration="0:0:0.3"/>
      </Transitions>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <shadui:ExpandableDecorator
          x:Name="PART_ExpandableDecorator"
          MinWidth="{TemplateBinding MinWidth}"
          MinHeight="{TemplateBinding MinWidth}"
          IsExpanded="{TemplateBinding IsExpanded}"
          Orientation="{TemplateBinding Orientation}">
          <shadui:ExpandableDecorator.Transitions>
            <Transitions>
              <DoubleTransition
                Easing="CubicEaseOut" Property="Progress"
                Duration="0:0:0.4"/>
            </Transitions>
          </shadui:ExpandableDecorator.Transitions>

          <DockPanel
            HorizontalSpacing="{TemplateBinding HorizontalSpacing}"
            VerticalSpacing="{TemplateBinding VerticalSpacing}">
            <Border
              x:Name="PART_TogglerBorder" DockPanel.Dock="Top"
              Width="{TemplateBinding MinWidth}"
              Height="{TemplateBinding MinWidth}"
              Padding="6" HorizontalAlignment="Left">
              <ToggleButton
                CornerRadius="{DynamicResource FullCornerRadius}"
                Cursor="Hand"
                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                Theme="{DynamicResource NavigationTogglerTheme}">
                <LucideIcon
                  Foreground="{DynamicResource ForegroundColor}"
                  Kind="PanelLeft" Size="18"/>
              </ToggleButton>
            </Border>

            <ContentPresenter
              x:Name="PART_FooterPresenter" DockPanel.Dock="Bottom"
              Content="{TemplateBinding Footer}"/>

            <Border
              x:Name="PART_ItemsBorder"
              Padding="{TemplateBinding Padding}"
              VerticalAlignment="Top"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.25" Easing="QuadraticEaseInOut"/>
                </Transitions>
              </Border.Transitions>
              <ScrollViewer
                Classes.Stack="{TemplateBinding IsExpanded, Converter={x:Static BoolConverters.Not}}"
                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <ItemsPresenter
                  x:Name="PART_ItemsPresenter" Grid.IsSharedSizeScope="True"
                  ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </shadui:ExpandableDecorator>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:vertical">
      <Style Selector="^ /template/ shadui|ExpandableDecorator#PART_ExpandableDecorator">
        <Setter Property="Orientation" Value="Horizontal"/>
      </Style>
      <Style Selector="^ /template/ shadui|ExpandableDecorator#PART_ExpandableDecorator[IsExpanded=True] Border#PART_ItemsBorder">
        <Setter Property="Background" Value="{DynamicResource NavigationBarBackgroundColor}"/>
      </Style>
    </Style>

    <Style Selector="^:horizontal">
      <Style Selector="^ /template/ shadui|ExpandableDecorator#PART_ExpandableDecorator">
        <Setter Property="Orientation" Value="Vertical"/>
      </Style>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </Setter>

      <Style Selector="^ /template/ Border#PART_TogglerBorder">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="DockPanel.Dock" Value="Left"/>
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_FooterPresenter">
        <Setter Property="DockPanel.Dock" Value="Right"/>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>