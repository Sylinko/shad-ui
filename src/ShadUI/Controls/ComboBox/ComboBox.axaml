<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI" xmlns:system="clr-namespace:System;assembly=netstandard">
  <Design.PreviewWith>
    <Border
      Width="400" Height="500"
      Padding="8">
      <StackPanel Spacing="8">
        <ComboBox
          Width="200" SelectedIndex="0">
          <ComboBoxItem>Next.js</ComboBoxItem>
          <ComboBoxItem>SvelteKit</ComboBoxItem>
          <ComboBoxItem>Nuxt.js</ComboBoxItem>
          <ComboBoxItem>Remix</ComboBoxItem>
          <ComboBoxItem>Astro</ComboBoxItem>
        </ComboBox>
        <ComboBox
          Width="200" shadui:ControlAssist.Hint="This control is currently disabled"
          shadui:ControlAssist.Label="Disabled Selection" SelectedIndex="0">
          <DataValidationErrors.Error>
            <system:Exception/>
          </DataValidationErrors.Error>
          <ComboBoxItem>Next.js</ComboBoxItem>
          <ComboBoxItem>SvelteKit</ComboBoxItem>
          <ComboBoxItem>Nuxt.js</ComboBoxItem>
          <ComboBoxItem>Remix</ComboBoxItem>
          <ComboBoxItem>Astro</ComboBoxItem>
        </ComboBox>
      </StackPanel>
    </Border>
  </Design.PreviewWith>
  <ControlTheme
    x:Key="ComboBoxControlTheme" TargetType="ComboBox">
    <Setter Property="BorderThickness" Value="1,1,1,1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource LgCornerRadius}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
    <Setter Property="PlaceholderForeground" Value="{DynamicResource MutedColor}"/>
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
    <Setter Property="Background" Value="{DynamicResource SelectionColor}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="shadui:ControlAssist.MinHeight" Value="36"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <VirtualizingStackPanel Margin="3"/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <StackPanel
            Background="Transparent" Spacing="4">
            <TextBlock
              Name="Label" Classes="Caption"
              Margin="0,0,0,6"
              IsVisible="{TemplateBinding shadui:ControlAssist.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{TemplateBinding shadui:ControlAssist.Label}"/>
            <Panel>
              <Border
                Name="BackgroundBorder"
                Height="{TemplateBinding shadui:ControlAssist.Height}"
                MinHeight="{TemplateBinding shadui:ControlAssist.MinHeight}"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition
                      Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition
                      Property="BorderBrush" Duration="0:0:0.15"/>
                  </Transitions>
                </Border.Transitions>
                <Grid
                  Background="Transparent" ColumnDefinitions="*,Auto">
                  <TextBlock
                    Name="PlaceholderTextBlock" Grid.Column="0"
                    Margin="12,0,0,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="Center"
                    Foreground="{TemplateBinding PlaceholderForeground}"
                    Text="{TemplateBinding PlaceholderText}">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding
                          Converter="{x:Static ObjectConverters.IsNull}"
                          Path="SelectionBoxItem"
                          RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding
                          Path="!IsEditable"
                          RelativeSource="{RelativeSource TemplatedParent}"/>
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                  <ContentControl
                    Grid.Column="0" Margin="12,0,0,0"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding SelectionBoxItem}"
                    ContentTemplate="{TemplateBinding ItemTemplate}"
                    Foreground="{DynamicResource ForegroundColor}"
                    IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}"
                    TextBlock.FontSize="{TemplateBinding FontSize}"
                    TextBlock.FontWeight="{TemplateBinding FontWeight}"
                    TextBlock.Foreground="{TemplateBinding Foreground}"/>
                  <TextBox
                    Name="PART_EditableTextBox" Grid.Column="0"
                    Margin="12,0,0,0"
                    Padding="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{TemplateBinding Foreground}"
                    IsVisible="{TemplateBinding IsEditable}"
                    Text="{TemplateBinding Text, Mode=TwoWay}">
                    <TextBox.Resources>
                      <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>
                  <Path
                    Name="Icon" Grid.Column="1"
                    Width="8" Margin="5,0,16,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="{x:Static shadui:Icons.ChevronUpDown}"
                    Fill="{DynamicResource MutedColor}"
                    Stretch="Uniform">
                    <Path.Transitions>
                      <Transitions>
                        <BrushTransition
                          Property="Fill" Duration="0:0:0.20"/>
                      </Transitions>
                    </Path.Transitions>
                  </Path>
                  <Popup
                    Name="PART_Popup" Grid.Column="0"
                    MinWidth="{CompiledBinding #BackgroundBorder.Bounds.Width}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                    IsLightDismissEnabled="True"
                    IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                    PlacementTarget="{CompiledBinding #BackgroundBorder}"
                    VerticalOffset="5">
                    <LayoutTransformControl
                      Name="LayoutTransform" RenderTransformOrigin="50%, 0%">
                      <Border
                        MinWidth="{CompiledBinding #BackgroundBorder.Bounds.Width}"
                        Margin="2,0,2,4"
                        Background="{DynamicResource PopupBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        BoxShadow="{DynamicResource Shadow}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <DockPanel>
                          <ContentPresenter
                            DockPanel.Dock="Bottom"
                            Content="{TemplateBinding shadui:ControlAssist.Footer}"/>

                          <ScrollViewer
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter
                              Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              TextBlock.FontSize="{TemplateBinding FontSize}"
                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                          </ScrollViewer>
                        </DockPanel>
                      </Border>
                    </LayoutTransformControl>
                  </Popup>
                </Grid>
              </Border>
            </Panel>
            <TextBlock
              Name="PART_Hint" Classes="Caption Muted"
              IsVisible="{TemplateBinding shadui:ControlAssist.Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{TemplateBinding shadui:ControlAssist.Hint}"/>
          </StackPanel>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:dropdownopen">
      <Style Selector="^ /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Background" Value="{DynamicResource SelectionHoverColor}"/>
      </Style>
      <Style Selector="^ /template/ LayoutTransformControl#LayoutTransform">
        <Style.Animations>
          <Animation
            Easing="CubicEaseInOut" FillMode="Forward"
            Duration="0:0:0.15">
            <KeyFrame Cue="0%">
              <Setter Property="TranslateTransform.Y" Value="-16"/>
              <Setter Property="Opacity" Value="0"/>
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="TranslateTransform.Y" Value="0"/>
              <Setter Property="Opacity" Value="1"/>
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </Style>
    <Style Selector="^:pointerover /template/ Border#BackgroundBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineColor}"/>
      <Setter Property="Background" Value="{DynamicResource SelectionHoverColor}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.50"/>
    </Style>
    <Style Selector="^:error">
      <Style Selector="^/template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}"/>
      </Style>
      <Style Selector="^/template/ Path#Icon">
        <Setter Property="Fill" Value="{DynamicResource ErrorColor}"/>
      </Style>
      <Style Selector="^/template/ TextBlock#Label">
        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
      </Style>
    </Style>
    <Style Selector="^[IsEditable=true]">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
    </Style>
  </ControlTheme>

  <ControlTheme
    x:Key="{x:Type ComboBox}"
    BasedOn="{StaticResource ComboBoxControlTheme}"
    TargetType="ComboBox"/>
</ResourceDictionary>