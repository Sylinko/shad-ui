<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  basic colors  -->
  <Color x:Key="TransparentColor">#00FFFFFF</Color>
  <Color x:Key="ForegroundColor">#08080B</Color>
  <Color x:Key="ForegroundLeadColor">#71717A</Color>
  <Color x:Key="BackgroundColor">Transparent</Color>
  <Color x:Key="MutedColor">#71717A</Color>
  <Color x:Key="BorderColor">#DEDEDE</Color>
  <Color x:Key="BorderColor60">#9CDEDEDE</Color>
  <Color x:Key="BorderColor30">#4CDEDEDE</Color>
  <Color x:Key="OutlineColor">#E5E5E5</Color>
  <Color x:Key="GhostColor">#E6E6E6</Color>
  <Color x:Key="GhostHoverColor">#7FE6E6E6</Color>
  <Color x:Key="GhostHoverColor50">#33E6E6E6</Color>
  <Color x:Key="SelectionColor">#66FFFFFF</Color>

  <!--  theme colors  -->
  <Color x:Key="SecondaryColor">#FFFFFF</Color>
  <Color x:Key="SecondaryColor75">#BFFFFFFF</Color>
  <Color x:Key="SecondaryColor50">#80FFFFFF</Color>
  <Color x:Key="SecondaryColor10">#19FFFFFF</Color>
  <Color x:Key="SecondaryForegroundColor">#08080B</Color>
  <Color x:Key="DestructiveColor">#E7000B</Color>
  <Color x:Key="DestructiveColor75">#BFE7000B</Color>
  <Color x:Key="DestructiveColor50">#80E7000B</Color>
  <Color x:Key="DestructiveColor10">#19E7000B</Color>
  <Color x:Key="DestructiveForegroundColor">#FAFAFA</Color>

  <!--  notification colors  -->
  <Color x:Key="InfoColor">#0288D1</Color>
  <Color x:Key="InfoColor60">#990288D1</Color>
  <Color x:Key="InfoColor20">#330288D1</Color>
  <Color x:Key="InfoColor10">#190288D1</Color>
  <Color x:Key="InfoColor5">#0D0288D1</Color>
  <Color x:Key="SuccessColor">#28A745</Color>
  <Color x:Key="SuccessColor60">#9928A745</Color>
  <Color x:Key="SuccessColor20">#3328A745</Color>
  <Color x:Key="SuccessColor10">#1928A745</Color>
  <Color x:Key="SuccessColor5">#0D2E7D32</Color>
  <Color x:Key="WarningColor">#ED6C02</Color>
  <Color x:Key="WarningColor60">#99ED6C02</Color>
  <Color x:Key="WarningColor20">#33ED6C02</Color>
  <Color x:Key="WarningColor10">#19ED6C02</Color>
  <Color x:Key="WarningColor5">#0DED6C02</Color>
  <Color x:Key="ErrorColor">#D32F2F</Color>
  <Color x:Key="ErrorColor60">#99D32F2F</Color>
  <Color x:Key="ErrorColor20">#33D32F2F</Color>
  <Color x:Key="ErrorColor10">#19D32F2F</Color>
  <Color x:Key="ErrorColor5">#0DD32F2F</Color>

  <!--  specific control colors  -->
  <Color x:Key="BadgeForegroundColor">#FAFAFA</Color>
  <Color x:Key="BusyAreaOverlayColor">#F2F2F2</Color>

  <Color x:Key="CardBackgroundColor">#66FFFFFF</Color>
  <Color x:Key="SecondaryCardBackgroundColor">#99E0E0E0</Color>

  <Color x:Key="DialogOverlayColor">#000000</Color>
  <Color x:Key="DialogBackgroundColor">#F2F2F2</Color>

  <Color x:Key="TitleBarBackgroundColor">#66FFFFFF</Color>
  <Color x:Key="PopupBackgroundColor">#FAFAFA</Color>
  <Color x:Key="ToolTipForegroundColor">#FAFAFA</Color>
  <Color x:Key="ToolTipBackgroundColor">#0A0A0D</Color>
  <Color x:Key="WindowBackgroundColor">#FFFFFF</Color>
  <Color x:Key="WindowButtonHoverColor">#0D09090B</Color>

  <Color x:Key="SidebarBackgroundColor">#66FFFFFF</Color>
  <Color x:Key="SliderThumbBackgroundColor">#FFFAFAFA</Color>

  <Color x:Key="SwitchBackgroundColor">#FFE5E5E5</Color>
  <Color x:Key="SwitchForegroundColor">#FFFFFFFF</Color>

  <Color x:Key="AcrylicWindowBackgroundColor">#EEFFFFFF</Color>
  <Color x:Key="QuoteColor">#CA5010</Color>
</ResourceDictionary>