<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  basic colors  -->
  <Color x:Key="TransparentColor">#00000000</Color>
  <Color x:Key="ForegroundColor">#E5E5E5</Color>
  <Color x:Key="ForegroundLeadColor">#A1A1AA</Color>
  <Color x:Key="BackgroundColor">#00000000</Color>
  <Color x:Key="MutedColor">#A0A0A9</Color>
  <Color x:Key="BorderColor">#353535</Color>
  <Color x:Key="BorderColor60">#9C353535</Color>
  <Color x:Key="BorderColor30">#4C353535</Color>
  <Color x:Key="OutlineColor">#3E3E3E</Color>
  <Color x:Key="GhostColor">#454545</Color>
  <Color x:Key="GhostHoverColor">#7F454545</Color>
  <Color x:Key="GhostHoverColor50">#33454545</Color>
  <Color x:Key="SelectionColor">#6609090B</Color>
  <Color x:Key="SelectionHoverColor">#3309090B</Color>

  <!--  theme colors  -->
  <Color x:Key="SecondaryColor">#2a2a2a</Color>
  <Color x:Key="SecondaryColor75">#BF2a2a2a</Color>
  <Color x:Key="SecondaryColor50">#802a2a2a</Color>
  <Color x:Key="SecondaryColor10">#192a2a2a</Color>
  <Color x:Key="SecondaryForegroundColor">#E5E5E5</Color>
  <Color x:Key="DestructiveColor">#E03131</Color>
  <Color x:Key="DestructiveColor75">#BFE03131</Color>
  <Color x:Key="DestructiveColor50">#80E03131</Color>
  <Color x:Key="DestructiveColor10">#19E03131</Color>
  <Color x:Key="DestructiveForegroundColor">#E5E5E5</Color>

  <!--  notification colors  -->
  <Color x:Key="InfoColor">#2979FF</Color>
  <Color x:Key="InfoColor60">#992979FF</Color>
  <Color x:Key="InfoColor20">#332979FF</Color>
  <Color x:Key="InfoColor10">#192979FF</Color>
  <Color x:Key="InfoColor5">#0D2979FF</Color>
  <Color x:Key="SuccessColor">#00C853</Color>
  <Color x:Key="SuccessColor60">#9900C853</Color>
  <Color x:Key="SuccessColor20">#3300C853</Color>
  <Color x:Key="SuccessColor10">#1900C853</Color>
  <Color x:Key="SuccessColor5">#0D00C853</Color>
  <Color x:Key="WarningColor">#FF8C00</Color>
  <Color x:Key="WarningColor60">#99FF8C00</Color>
  <Color x:Key="WarningColor20">#33FF8C00</Color>
  <Color x:Key="WarningColor10">#19FF8C00</Color>
  <Color x:Key="WarningColor5">#0DFF8C00</Color>
  <Color x:Key="ErrorColor">#FF1744</Color>
  <Color x:Key="ErrorColor60">#99FF1744</Color>
  <Color x:Key="ErrorColor20">#33FF1744</Color>
  <Color x:Key="ErrorColor10">#19FF1744</Color>
  <Color x:Key="ErrorColor5">#0DFF1744</Color>

  <!--  specific control colors  -->
  <Color x:Key="BadgeForegroundColor">#FAFAFA</Color>
  <Color x:Key="BusyAreaOverlayColor">#1971717A</Color>
  <Color x:Key="NavigationBarBackgroundColor">#171717</Color>
  <Color x:Key="SettingsItemBackgroundColor">#0DFFFFFF</Color>
  <Color x:Key="SettingsItemHoverBackgroundColor">#1AFFFFFF</Color>

  <Color x:Key="ListBoxItemHoverColor">#AF323232</Color>
  <Color x:Key="ListBoxItemSelectedColor">#323232</Color>

  <Color x:Key="CardBackgroundColor">#661A1A1A</Color>
  <Color x:Key="SecondaryCardBackgroundColor">#9909090B</Color>

  <Color x:Key="DialogOverlayColor">#000000</Color>
  <Color x:Key="DialogBackgroundColor">#1A1A1A</Color>

  <Color x:Key="TitleBarBackgroundColor">#660A0A0A</Color>
  <Color x:Key="PopupBackgroundColor">#1A1A1A</Color>
  <Color x:Key="ToolTipForegroundColor">#181818</Color>
  <Color x:Key="ToolTipBackgroundColor">#FAFAFA</Color>
  <Color x:Key="WindowBackgroundColor">#EE090909</Color>
  <Color x:Key="WindowButtonHoverColor">#0DFAFAFA</Color>

  <Color x:Key="SidebarBackgroundColor">#660A0A0A</Color>
  <Color x:Key="SliderThumbBackgroundColor">#FFFAFAFA</Color>

  <Color x:Key="SwitchBackgroundColor">#66454545</Color>
  <Color x:Key="SwitchForegroundColor">#66FAFAFA</Color>

  <Color x:Key="AcrylicWindowBackgroundColor">#EE1A1A1A</Color>
