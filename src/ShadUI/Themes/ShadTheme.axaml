<Styles
  x:Class="ShadUI.ShadTheme" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="clr-namespace:ShadUI.Themes">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <themes:SystemAccentColors/>
        <ResourceInclude Source="avares://ShadUI/Controls/Constants.axaml"/>
        <ResourceInclude Source="avares://ShadUI/Controls/Resources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude
          x:Key="{x:Static ThemeVariant.Light}"
          Source="avares://ShadUI/Themes/Light.axaml"/>
        <ResourceInclude
          x:Key="{x:Static ThemeVariant.Dark}"
          Source="avares://ShadUI/Themes/Dark.axaml"/>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <StyleInclude Source="avares://ShadUI/Controls/Styles.axaml"/>
</Styles>