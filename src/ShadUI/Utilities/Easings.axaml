<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI.Controls;assembly=ShadUI">
  <shadui:EaseInBackOutBack
    x:Key="SoftEaseInBackOutBack" BounceIntensity="Soft"/>
  <shadui:EaseInBackOutBack
    x:Key="NormalEaseInBackOutBack" BounceIntensity="Normal"/>
  <shadui:EaseInBackOutBack
    x:Key="StrongEaseInBackOutBack" BounceIntensity="Strong"/>
  <shadui:EaseInOutBack
    x:Key="SoftEaseInOutBack" BounceIntensity="Soft"/>
  <shadui:EaseInOutBack
    x:Key="NormalEaseInOutBack" BounceIntensity="Normal"/>
  <shadui:EaseInOutBack
    x:Key="StrongEaseInOutBack" BounceIntensity="Strong"/>
  <shadui:EaseOutBack
    x:Key="SoftEaseOutBack" BounceIntensity="Soft"/>
  <shadui:EaseOutBack
    x:Key="NormalEaseOutBack" BounceIntensity="Normal"/>
  <shadui:EaseOutBack
    x:Key="StrongEaseOutBack" BounceIntensity="Strong"/>
  <shadui:EaseOut x:Key="ShadEaseOut"/>
  <shadui:EaseInOut x:Key="ShadEaseInOut"/>
</ResourceDictionary>
